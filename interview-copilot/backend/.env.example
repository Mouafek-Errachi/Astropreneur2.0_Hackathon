GEMINI_API_KEY=
GEMINI_MODEL_LIVE=gemini-2.5-flash
GEMINI_MODEL_SUMMARY=gemini-3-flash-preview
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
# Local testing only: skips JWT check
DEV_AUTH_BYPASS=true
# Extra allowed browser origins, e.g. ["https://hr.example.com"] (the extension needs none)
CORS_ORIGINS=[]

# Speech-to-text: auto = Deepgram if DEEPGRAM_API_KEY is set, otherwise local Whisper (no account needed)
#   whisper = local model on this PC; gemini = uses GEMINI_API_KEY; deepgram = needs DEEPGRAM_API_KEY
STT_PROVIDER=auto
# Leave empty to detect the language, or set en / fr / ar ... (whisper and gemini)
STT_LANGUAGE=
# tiny | base | small | medium (bigger = more accurate, slower; small is a good CPU default)
WHISPER_MODEL=small

# Deepgram (optional)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# "en", "es", "fr", "de", ... or "multi" for mixed languages (check Deepgram docs for your language)
DEEPGRAM_LANGUAGE=en

# Storage: SQLite locally, PostgreSQL in production, e.g. postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./copilot.db
# Confirmed interviews (transcript, summary, notes, files) are deleted after this many days
RETENTION_DAYS=180
# Interviews never confirmed (no download) are dropped from memory after this many hours
UNCONFIRMED_TTL_HOURS=12
