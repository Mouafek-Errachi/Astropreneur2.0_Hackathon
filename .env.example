# Copy to .env and adjust
ENVIRONMENT=dev               # anything else than dev refuses to start with a default JWT_SECRET
LLM_MODE=mock                 # mock | live (use live for the demo)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_CONCURRENCY=6             # parallel LLM calls when screening or classifying in bulk
JWT_SECRET=change-me-to-a-long-random-string
WEBHOOK_SECRET=change-me-webhook-secret
DATABASE_URL=sqlite:///./var/app.db
CORS_ORIGINS=http://localhost:8501
DEFAULT_RATE_LIMIT=300/minute
LOGIN_RATE_LIMIT=5/minute
DEMO_ADMIN_PASSWORD=Admin#2026!
DEMO_RECRUITER_PASSWORD=Recruiter#2026!
DEMO_VIEWER_PASSWORD=Viewer#2026!

# Human-in-the-loop rules
FOUR_EYES_DECISIONS=true      # whoever proposes a decision about a candidate cannot approve it
REMINDER_AFTER_DAYS=3
UNANSWERED_EMAIL_HOURS=48
ENABLE_DEMO_DATA=true         # admin-only loader of fictional data; set false outside demos

# Dashboard -> n8n backend (optional, for the HR Ops page). Raw keys here; n8n stores only their SHA-256.
# N8N_BASE_URL looks like https://<your-n8n-host>/webhook
N8N_BASE_URL=
N8N_HR_KEY=
N8N_HR_ADMIN_KEY=
N8N_PORTAL_KEY=
N8N_EXTENSION_KEY=
