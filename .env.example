# Copy to .env and adjust. Everything works with the defaults (mock LLM, SQLite, no SMTP).
ENVIRONMENT=dev                    # anything else than dev refuses to start with a default JWT_SECRET

# ---- L3 agents: mock | gemini | grok  (+ optional fallback provider)
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=
WRITER_LLM_PROVIDER=               # optional: the AI that turns HR notes into formal emails (e.g. grok); empty = LLM_PROVIDER
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-3.6-flash   # used in turn when one is rate-limited
GROK_API_KEY=
GROK_MODEL=grok-4
LLM_CONCURRENCY=6                  # parallel LLM calls when screening or classifying in bulk
EMBEDDINGS_PROVIDER=local          # local | gemini

# ---- L5 secrets (change all of these outside a demo)
JWT_SECRET=change-me-to-a-long-random-string
APPROVAL_SIGNING_SECRET=change-me-approval-signing-secret
WEBHOOK_SECRET=change-me-webhook-secret
DEFAULT_RATE_LIMIT=300/minute
LOGIN_RATE_LIMIT=5/minute

# ---- Human-in-the-loop rules
FOUR_EYES_DECISIONS=true           # whoever proposes a decision about a candidate (or learned weights) cannot approve it
REMINDER_AFTER_DAYS=3              # remind a candidate who has not answered our last email
UNANSWERED_EMAIL_HOURS=48
ENABLE_DEMO_DATA=true              # admin-only loader of fictional data; set false outside demos

# ---- L4 data: SQLite by default. With `docker compose --profile postgres`:
# DATABASE_URL=postgresql+psycopg://hr:hr-dev-password@postgres:5432/hr
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ---- Executor mail: empty = emails are recorded in the outbox only.
# Local test without Docker: run `.venv\Scripts\python -m aiosmtpd -n -l 127.0.0.1:1025` and set SMTP_HOST=127.0.0.1
# (every approved email is printed in that terminal). With `docker compose --profile mail`: SMTP_HOST=mailhog,
# then open http://localhost:8025
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=hr@acme.test
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---- Demo users (created on first start; an outdated var/app.db is backed up and recreated automatically)
DEMO_ADMIN_PASSWORD=Admin#2026!
DEMO_RECRUITER_PASSWORD=Recruiter#2026!
DEMO_VIEWER_PASSWORD=Viewer#2026!
DEMO_EMPLOYEE_PASSWORD=Employee#2026!
DEMO_MANAGER_PASSWORD=Manager#2026!

# ---- Optional: dashboard -> standalone n8n backend (page "HR Ops via n8n"). Raw keys here; n8n stores only SHA-256.
# N8N_BASE_URL looks like https://<your-n8n-host>/webhook
N8N_BASE_URL=
N8N_HR_KEY=
N8N_HR_ADMIN_KEY=
N8N_PORTAL_KEY=
N8N_EXTENSION_KEY=
