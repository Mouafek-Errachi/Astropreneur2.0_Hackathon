    {
      "id": "487af6c4-b6d9-467c-bb56-84ce3cd78074",
      "name": "Apply Rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const v = $('Authorize and Validate').first().json;\nconst rule = $('Lookup Rule').first().json || {};\nconst emp = $('Lookup Employee').first().json || {};\nconst dup = $('Lookup Idempotency Key').first().json || {};\nconst ledger = $('Lookup Employee Ledger').all().map(i => i.json).filter(r => r.ledger_id);\nconst rid = v.request_id;\nconst fail = (status, code, message) => [{ json: { outcome: 'respond', status_code: status, response: { ok: false, request_id: rid, error: { code, message } } } }];\nconst period = $now.toFormat('yyyy-MM');\nconst today = $now.toFormat('yyyy-MM-dd');\nconst sum = (rows) => rows.reduce((s, r) => s + Number(r.points || 0), 0);\nconst badges = (periodRows, allRows) => {\n  const b = [];\n  const t = sum(periodRows);\n  if (t >= 500) b.push('Gold'); else if (t >= 250) b.push('Silver'); else if (t >= 100) b.push('Bronze');\n  if (periodRows.filter(r => r.action_type === 'mentoring_session').length >= 3) b.push('Mentor');\n  if (periodRows.filter(r => r.action_type === 'peer_review').length >= 5) b.push('Reviewer');\n  if (allRows.some(r => r.action_type === 'completed_onboarding')) b.push('Fast Starter');\n  return b;\n};\nif (dup.ledger_id) {\n  if (dup.employee_id !== v.employee_id || dup.action_type !== v.action_type) return fail(409, 'IDEMPOTENCY_CONFLICT', 'idempotency_key was already used for a different award');\n  const pr = ledger.filter(r => r.period === dup.period);\n  return [{ json: { outcome: 'respond', status_code: 200, response: { ok: true, request_id: rid, data: { status: 'recorded', ledger_id: dup.ledger_id, employee_id: dup.employee_id, action_type: dup.action_type, points_awarded: dup.points, period: dup.period, period_total: sum(pr), badges_unlocked: [], duplicate: true } } } }];\n}\nif (!rule.action_type) return fail(422, 'UNKNOWN_ACTION', 'action_type is not in the points rules');\nif (!emp.employee_id || emp.active !== true) return fail(404, 'EMPLOYEE_NOT_FOUND', 'Unknown or inactive employee');\nif (v.awarded_by === v.employee_id) return fail(403, 'SELF_AWARD', 'awarded_by cannot be the same person as employee_id');\nif (rule.action_type === 'completed_onboarding' && ledger.some(r => r.action_type === 'completed_onboarding')) return fail(409, 'CAP_REACHED', 'completed_onboarding can only be awarded once');\nconst todayCount = ledger.filter(r => r.action_type === rule.action_type && r.awarded_on === today).length;\nif (todayCount >= Number(rule.daily_cap || 1)) return fail(409, 'CAP_REACHED', 'Daily cap of ' + rule.daily_cap + ' reached for ' + rule.action_type);\nconst points = Number(rule.points);\nconst row = { ledger_id: 'pts_' + $execution.id, employee_id: v.employee_id, action_type: rule.action_type, points, period, awarded_on: today, awarded_by: v.awarded_by, note: v.note, source: v.source, idempotency_key: v.idempotency_key };\nif (v.source === 'automation') {\n  const approval_id = 'apr_' + $execution.id;\n  const payload = { row, draft: { subject: 'Points award for ' + emp.first_name, body: '+' + points + ' points to ' + v.employee_id + ' for ' + rule.action_type + (v.note ? ' (' + v.note + ')' : '') } };\n  return [{ json: { outcome: 'queue', approval_id, awarded_by: v.awarded_by, employee_id: v.employee_id, payload_json: JSON.stringify(payload), status_code: 202, response: { ok: true, request_id: rid, data: { status: 'pending_approval', approval_id, employee_id: v.employee_id, action_type: rule.action_type, points_pending: points } } } }];\n}\nconst before = ledger.filter(r => r.period === period);\nconst b0 = badges(before, ledger);\nconst b1 = badges(before.concat([row]), ledger.concat([row]));\nconst unlocked = b1.filter(x => !b0.includes(x));\nreturn [{ json: { outcome: 'record', row, status_code: 201, response: { ok: true, request_id: rid, data: { status: 'recorded', ledger_id: row.ledger_id, employee_id: v.employee_id, action_type: rule.action_type, points_awarded: points, period, period_total: sum(before) + points, badges_unlocked: unlocked, duplicate: false } } } }];"
      }
    },
