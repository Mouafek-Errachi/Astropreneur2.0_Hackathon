    {
      "id": "b2183273-3974-4abb-9335-00ae3663bebb",
      "name": "Authorize and Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const req = $('Award Points Webhook').first().json;\nconst key = $input.first().json || {};\nconst rid = 'req_' + $execution.id;\nconst fail = (status, code, message) => [{ json: { valid: false, status_code: status, response: { ok: false, request_id: rid, error: { code, message } } } }];\nif (!key.api_key_sha256 || key.active !== true || !['hr', 'hr_admin'].includes(key.client)) return fail(401, 'UNAUTHORIZED', 'Missing or invalid API key for this endpoint');\nconst body = (req.body && typeof req.body === 'object' && !Array.isArray(req.body)) ? req.body : {};\nconst errors = [];\nconst ALLOWED = ['employee_id', 'action_type', 'awarded_by', 'note', 'source', 'idempotency_key'];\nfor (const k of Object.keys(body)) if (!ALLOWED.includes(k)) errors.push('unknown field: ' + k);\nconst ID = /^[A-Za-z0-9_-]{1,64}$/;\nif (!ID.test(String(body.employee_id || ''))) errors.push('employee_id is required (letters, digits, _ or -)');\nconst owner = String(key.owner_id || '');\nif (!/^[A-Za-z0-9_-]{1,64}$/.test(owner)) return fail(403, 'KEY_NOT_BOUND', 'This API key is not bound to a person');\nif (body.awarded_by != null && body.awarded_by !== owner) return fail(403, 'IDENTITY_MISMATCH', 'awarded_by must match the owner of the API key');\nif (!/^[a-z_]{2,40}$/.test(String(body.action_type || ''))) errors.push('action_type must be lowercase letters or underscores');\nif (body.note != null && (typeof body.note !== 'string' || body.note.length > 200)) errors.push('note must be a string of at most 200 characters');\nconst source = body.source == null ? 'hr_dashboard' : body.source;\nif (!['hr_dashboard', 'automation'].includes(source)) errors.push('source must be hr_dashboard or automation');\nif (!/^[A-Za-z0-9_.:-]{8,80}$/.test(String(body.idempotency_key || ''))) errors.push('idempotency_key is required (8-80 characters: letters, digits, _ . : -)');\nif (errors.length) return fail(400, 'VALIDATION_ERROR', errors.join('; '));\nconst note = String(body.note || '').replace(/<[^>]*>/g, '').trim();\nreturn [{ json: { valid: true, request_id: rid, employee_id: body.employee_id, action_type: body.action_type, awarded_by: owner, note, source, idempotency_key: body.idempotency_key } }];"
      }
    },
