        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "hr_api_keys"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "api_key_sha256",
              "condition": "eq",
              "keyValue": "={{ String($json.headers[\"x-api-key\"] || \"missing\").hash(\"sha256\") }}"
