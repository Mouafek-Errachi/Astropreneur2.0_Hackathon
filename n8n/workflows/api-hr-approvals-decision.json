    {
      "id": "a742efa8-ab70-48d6-b9ea-bbef6e0d34a3",
      "name": "Lookup API Key",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        200,
        400
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "hr_api_keys"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "api_key",
              "condition": "eq",
              "keyValue": "={{ $json.headers[\"x-api-key\"] || \"missing\" }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "alwaysOutputData": true
    },
    {
      "id": "6221db12-54d3-4f29-bfed-40bcfddd7aff",
      "name": "Authorize and Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const req = $('Decision Webhook').first().json;\nconst key = $input.first().json || {};\nconst rid = 'req_' + $execution.id;\nconst fail = (status, code, message) => [{ json: { valid: false, status_code: status, response: { ok: false, request_id: rid, error: { code, message } } } }];\nif (!key.api_key || key.active !== true || key.client !== 'hr_admin') return fail(401, 'UNAUTHORIZED', 'Only the HR admin key can decide approvals');\nconst body = (req.body && typeof req.body === 'object' && !Array.isArray(req.body)) ? req.body : {};\nconst errors = [];\nfor (const k of Object.keys(body)) if (!['approval_id', 'decision', 'reviewer_id', 'reason', 'edited_content'].includes(k)) errors.push('unknown field: ' + k);\nif (!/^apr_\\d{1,12}$/.test(String(body.approval_id || ''))) errors.push('approval_id must look like apr_123');\nif (!['approve', 'reject'].includes(body.decision)) errors.push('decision must be approve or reject');\nif (!/^[A-Za-z0-9_-]{1,64}$/.test(String(body.reviewer_id || ''))) errors.push('reviewer_id is required (letters, digits, _ or -)');\nconst clean = (s, n) => String(s ?? '').normalize('NFKC').replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\u200B-\\u200F\\u202A-\\u202E\\uFEFF]/g, '').replace(/<[^>]*>/g, '').trim().slice(0, n);\nconst reason = body.reason == null ? '' : clean(body.reason, 300);\nif (body.reason != null && (typeof body.reason !== 'string' || body.reason.length > 300)) errors.push('reason must be a string of at most 300 characters');\nif (body.decision === 'reject' && !reason) errors.push('reason is required to reject');\nlet edited = null;\nif (body.edited_content != null) {\n  const ec = body.edited_content;\n  if (typeof ec !== 'object' || Array.isArray(ec)) errors.push('edited_content must be an object with subject and/or body');\n  else {\n    for (const k of Object.keys(ec)) if (!['subject', 'body'].includes(k)) errors.push('unknown edited_content field: ' + k);\n    if (ec.subject != null && (typeof ec.subject !== 'string' || ec.subject.length > 150)) errors.push('edited_content.subject must be at most 150 characters');\n    if (ec.body != null && (typeof ec.body !== 'string' || ec.body.length > 5000)) errors.push('edited_content.body must be at most 5000 characters');\n    edited = { subject: ec.subject == null ? null : clean(ec.subject, 150), body: ec.body == null ? null : clean(ec.body, 5000) };\n  }\n}\nif (errors.length) return fail(400, 'VALIDATION_ERROR', errors.join('; '));\nreturn [{ json: { valid: true, request_id: rid, approval_id: body.approval_id, decision: body.decision, reviewer_id: body.reviewer_id, reason, edited_content: edited } }];"
      }
    },
    {
      "id": "3640942b-ff56-440a-9080-8783797857eb",
      "name": "Is Valid",
      "type": "n8n-nodes-base.if",
