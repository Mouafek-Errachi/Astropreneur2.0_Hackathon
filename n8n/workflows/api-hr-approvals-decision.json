      "typeVersion": 2,
      "position": [
        2800,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const d = $('Check Decision').first().json;\nconst status = d.type === 'points_award' ? 'recorded' : 'sent';\nreturn [{ json: { status_code: 200, response: { ok: true, request_id: d.request_id, data: { approval_id: d.approval_id, type: d.type, status, decided_by: d.reviewer_id, edited_by_human: d.edited, decided_at: d.decided_at } } } }];"
      }
    },
