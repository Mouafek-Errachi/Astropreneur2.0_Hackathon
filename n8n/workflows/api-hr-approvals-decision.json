      "typeVersion": 2,
      "position": [
        2800,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const d = $('Check Decision').first().json;\nreturn [{ json: { status_code: 502, response: { ok: false, request_id: d.request_id, error: { code: 'DISPATCH_FAILED', message: 'Approved, but the email could not be sent. Check the SMTP credential, then approve again to retry.' }, data: { approval_id: d.approval_id, type: d.type, status: 'failed' } } } }];"
      }
    },
