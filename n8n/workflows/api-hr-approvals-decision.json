    {
      "id": "df908a9e-f5ad-40e9-b7a6-401ce3fbaf3e",
      "name": "Check Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const v = $('Authorize and Validate').first().json;\nconst a = $input.first().json || {};\nconst rid = v.request_id;\nconst deny = (status, code, message) => [{ json: { outcome: 'respond', approval_id: v.approval_id, reviewer_id: v.reviewer_id, audit_action: 'decision_denied', audit_details: code, ai_json: '', final_json: '', status_code: status, response: { ok: false, request_id: rid, error: { code, message } } } }];\nif (!a.approval_id) return deny(404, 'NOT_FOUND', 'Approval not found');\nif (!['pending_approval', 'failed'].includes(a.status)) return deny(409, 'ALREADY_DECIDED', 'This approval is already ' + a.status);\nif (a.type === 'broadcast' && a.created_by === v.reviewer_id) return deny(403, 'FOUR_EYES', 'The person who created a broadcast cannot approve it');\nlet p = {};\ntry { p = JSON.parse(a.payload || '{}'); } catch (e) { p = {}; }\nconst aiDraft = p.ai_draft || p.draft || null;\nlet finalDraft = p.draft || null;\nlet edited = false;\nif (v.decision === 'approve' && v.edited_content && finalDraft) {\n  finalDraft = { subject: v.edited_content.subject || finalDraft.subject, body: v.edited_content.body || finalDraft.body };\n  edited = !aiDraft || finalDraft.subject !== aiDraft.subject || finalDraft.body !== aiDraft.body;\n}\np.draft = finalDraft;\nreturn [{ json: {\n  outcome: v.decision, type: a.type, approval_id: a.approval_id, target_ref: a.target_ref,\n  reviewer_id: v.reviewer_id, reason: v.reason, edited, decided_at: $now.toISO(), request_id: rid,\n  payload: p, payload_json: JSON.stringify(p),\n  ai_json: JSON.stringify(aiDraft), final_json: JSON.stringify(finalDraft),\n  audit_action: v.decision === 'approve' ? 'approval_approved' : 'approval_rejected', audit_details: v.reason || ''\n} }];"
      }
    },
