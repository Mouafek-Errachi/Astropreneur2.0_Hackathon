flowchart TB
  subgraph L1["L1 Presentation (Streamlit, dashboard/)"]
    DASH["Inbox by urgency"]
    HITL["HITL Approval Queue"]
    SECV["AI Firewall Visualizer"]
    CHAT["Candidate Profile Chat"]
    OPS["HR Ops: tickets, broadcast, points, interview co-pilot"]
  end

  subgraph L5["L5 Security and Infra (backend/security/, cross-cutting)"]
    GW["Gateway: JWT, API keys, RBAC scopes, tenant scoping, rate limit"]
    IG["Injection Guard: file checks, hidden text, sanitize, scan, quarantine"]
    OV["Output Validator: schema + links + fact check + citations"]
    AUD["Audit Logger (hash-chained) + Security Events"]
    EXE["Action Executor (ONLY holder of SMTP credentials)"]
  end

  subgraph L2["L2 Orchestration (backend/orchestration/ + n8n/)"]
    N8N["n8n: IMAP / cron / webhooks"]
    ING["Ingestion: email + resumes"]
    WF["Workflows: screening, inbox/reply, scheduling, HR ops (propose = interrupt, resume after decision)"]
    SCH["Scheduler: follow-ups, reminders, magic-link tokens"]
  end

  subgraph L3["L3 AI Agents (backend/agents/, Gemini | Grok | mock)"]
    CLS["Email Classifier"]
    RNK["Resume Ranker + Justifier"]
    DRF["Reply Drafter (candidate-scoped)"]
    POL["Policy RAG"]
    BIAS["Bias Auditor"]
    CC["Candidate Chat"]
    HRA["Interview co-pilot, Broadcast writer, Ticket triage"]
  end

  subgraph L4["L4 Data (backend/data/)"]
    PG[("SQLite or Postgres: pipeline, approvals, audit")]
    VEC[("Embeddings: resumes, jobs, policies (pgvector-ready)")]
    FS[("Quarantine + UUID file storage")]
  end

  DASH --> GW
  HITL --> GW
  CHAT --> GW
  OPS --> GW
  SECV -. "events / WS" .- AUD
  N8N -- "signed webhook / API key" --> GW
  GW --> ING --> IG --> WF
  GW --> WF
  WF --> CLS & RNK & DRF & POL & CC & HRA
  RNK --> BIAS
  CLS & RNK & DRF & HRA --> OV
  OV --> PG
  RNK & POL --> VEC
  IG --> FS
  SCH --> WF
  HITL -- "signed approval" --> EXE
  EXE -- "resume workflow" --> WF
  EXE --> AUD
  IG --> AUD
  AUD --> PG
