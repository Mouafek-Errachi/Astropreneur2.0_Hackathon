classDiagram
  class Candidate { +UUID id +str name +str email +str stage }
  class Resume { +UUID id +str raw_text +str hidden_text +json embedding +float injection_score +json flags }
  class JobOffer { +UUID id +str title +json criteria +json embedding }
  class Application { +UUID id +float match_score +json criteria_justification +int rank +str status }
  class EmailMessage { +UUID id +str body +str urgency +str category +bool quarantined }
  class ProposedAction { +UUID id +str type +json payload +str status +str created_by_agent +str risk_level }
  class Approval { +UUID id +UUID reviewer_id +str decision +str payload_hash +datetime decided_at +str signature }
  class SentEmail { +UUID id +str to +str transport +str message_id }
  class AuditLog { +int id +str actor +str event +json detail +str prev_hash +str hash }
  class SecurityEvent { +int id +str source +str kind +str severity }
  class PolicyChunk { +UUID id +str doc_id +str section +str region +str lang +text content +json embedding }
  class SchedulingToken { +str jti +UUID candidate_id +datetime expires_at +bool used }
  class FairnessReport { +UUID application_id +float rank_delta +json counterfactuals }
  class Employee { +str id +str team_id +float leave_balance_days }
  class Ticket { +UUID id +str category +str status }
  class PointsLedger { +UUID id +str action_type +int points +str idempotency_key }

  Candidate "1" --> "0..*" Resume
  Candidate "1" --> "0..*" Application
  JobOffer "1" --> "0..*" Application
  Candidate "1" --> "0..*" EmailMessage
  EmailMessage "1" --> "0..*" ProposedAction : triggers
  Ticket "1" --> "0..1" ProposedAction : triggers
  ProposedAction "1" --> "0..1" Approval : requires
  ProposedAction "1" --> "0..*" SentEmail : executor only
  Application "1" --> "0..1" FairnessReport
  Candidate "1" --> "0..*" SchedulingToken
  Employee "1" --> "0..*" Ticket
  Employee "1" --> "0..*" PointsLedger
  ProposedAction ..> AuditLog : every transition logs
  Approval ..> AuditLog
